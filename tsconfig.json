{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Nodenext",
    "moduleResolution": "Nodenext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "utils/**/*.ts",
    "src/**/*.ts",
    "playwright.config.ts"
  ]
}
